<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!--<item name="android:windowAnimationStyle">@style/activityTransitionsAnimations</item>-->
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen
        </item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar
        </item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Widget.AppTheme.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/colorPrimary</item>
    </style>

    <!--Animations styles-->

    <style name="activityTransitionsAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_in_right</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!--Tab layout styles-->

    <style name="TabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabRippleColor">@null</item>
        <item name="android:background">@color/colorPrimary</item>
        <item name="tabBackground">@android:color/transparent</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
        <item name="tabIconTint">@color/selector_tab_icon_color</item>
        <item name="tabIndicatorColor">@color/tabSelectedTextColor</item>
        <item name="tabSelectedTextColor">@color/tabSelectedTextColor</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.AppCompat.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tabTextColor</item>
        <item name="android:textSize">@dimen/small_text_size</item>
    </style>

    <!--Card views styles-->

    <style name="cardMarginStyle">
        <item name="android:layout_marginStart">@dimen/default_material_margin</item>
        <item name="android:layout_marginEnd">@dimen/default_material_margin</item>
        <item name="android:layout_marginTop">@dimen/half_material_margin</item>
        <item name="android:layout_marginBottom">@dimen/half_material_margin</item>
    </style>

    <style name="smallCardStyle" parent="CardView">
        <item name="android:layout_width">@dimen/zero</item>
        <item name="android:layout_height">@dimen/small_card_height</item>
        <item name="android:layout_marginTop">@dimen/smallest_material_margin</item>
        <item name="android:layout_marginBottom">@dimen/smallest_material_margin</item>
    </style>

    <style name="bottomTopCardStyle" parent="CardView">
        <item name="android:layout_width">@dimen/landscape_card_width</item>
        <item name="android:layout_height">@dimen/landscape_card_height</item>
        <item name="android:layout_marginEnd">@dimen/default_material_margin</item>
        <item name="android:layout_marginTop">@dimen/smallest_material_margin</item>
        <item name="android:layout_marginBottom">@dimen/smallest_material_margin</item>
    </style>

    <style name="homeBottomCardStyle" parent="CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/default_material_margin</item>
        <item name="android:layout_marginTop">@dimen/half_material_margin</item>
        <item name="android:layout_marginStart">@dimen/default_material_margin</item>
        <item name="android:layout_marginBottom">@dimen/default_material_margin</item>
    </style>

    <!--Bottom Sheet Dialog Styles-->

    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/layout_rounded_shape</item>
    </style>

    <!--Alert Dialog Styles-->

    <style name="AlertDialogShapeAppearanceStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/default_material_margin</item>
    </style>

    <style name="AlertDialogStyle" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/AlertDialogShapeAppearanceStyle</item>
    </style>

    <style name="AlertDialogBodyStyle" parent="">
        <item name="android:textColor">@color/defaultFontColor</item>
        <item name="android:textSize">@dimen/default_text_size</item>
        <item name="android:paddingHorizontal">@dimen/default_material_margin</item>
    </style>

    <style name="AlertDialogButtonStyle" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="textAllCaps">true</item>
        <item name="android:layout_margin">@dimen/half_material_margin</item>
    </style>

    <style name="AlertDialogBuilderStyle" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/AlertDialogStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AlertDialogBodyStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogPositiveTextStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogNegativeTextStyle</item>
    </style>

    <style name="AlertDialogPositiveTextStyle" parent="Widget.MaterialComponents.Button">
        <item name="materialThemeOverlay">@style/AlertDialogButtonStyle</item>
    </style>

    <style name="AlertDialogNegativeTextStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/AlertDialogButtonStyle</item>
    </style>

    <!--Text view styles-->

    <style name="TitleTextView" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textColor">@color/colorBlack</item>
        <item name="android:background">@color/colorPrimaryLight</item>
        <item name="android:gravity">center|center_horizontal|center_vertical</item>
    </style>

    <style name="SubTitleTextView" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textColor">@color/defaultFontColor</item>
        <item name="android:background">@color/colorWhite</item>
        <item name="android:gravity">center|center_horizontal|center_vertical</item>
    </style>

    <style name="TitleTopRoundedTextView" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:background">@drawable/layout_top_rounded_shape</item>
        <item name="android:gravity">center|center_horizontal|center_vertical</item>
    </style>

    <!--Hint text styles-->

    <style name="HintTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--Focus edit text styles-->

    <style name="FocusEditTextTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorControlNormal">@color/defaultFontColor</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorPrimary</item>
    </style>

</resources>
