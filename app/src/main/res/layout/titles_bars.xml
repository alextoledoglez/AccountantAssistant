<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/half_material_margin"
    android:visibility="visible"
    app:cardBackgroundColor="@color/design_default_color_background"
    app:cardCornerRadius="@dimen/card_view_default_radius"
    app:cardElevation="@dimen/card_view_elevation"
    app:cardUseCompatPadding="true"
    app:contentPadding="@dimen/card_view_content_padding">

    <LinearLayout
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_height"
            android:theme="@style/TitleTextView" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMoney"
                android:layout_width="match_parent"
                android:layout_height="@dimen/title_height"
                android:layout_margin="@dimen/small_material_margin"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_money"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/title_height"
                android:layout_margin="@dimen/small_material_margin"
                android:layout_weight="0.5"
                android:theme="@style/SubTitleTextView" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scActive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/title_height"
                android:layout_margin="@dimen/small_material_margin"
                android:layout_weight="1"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <SearchView
                android:id="@+id/svSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/small_material_margin"
                android:iconifiedByDefault="false"
                android:queryHint="@string/search_view_hint_message" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>