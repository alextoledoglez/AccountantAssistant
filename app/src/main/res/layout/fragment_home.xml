<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/defaultBackgroundColor"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_horizontal"
    tools:context=".ui.home.HomeFragment">

    <include
        android:id="@+id/dashboard_card"
        style="@style/bottomTopCardStyle"
        layout="@layout/layout_home_subtitle_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/available_card"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/lytChartCardView"
        style="@style/cardMarginStyle"
        layout="@layout/layout_home_chart_card_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zero"
        app:layout_constraintBottom_toTopOf="@id/available_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dashboard_card" />

    <include
        android:id="@+id/available_card"
        style="@style/homeBottomCardStyle"
        layout="@layout/layout_home_title_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytChartCardView" />

</androidx.constraintlayout.widget.ConstraintLayout>
